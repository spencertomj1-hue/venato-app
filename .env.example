# Environment variables Venato reads. All optional.
# Venato does NOT load this file by itself. Copy it to .env (git ignores .env), fill in what
# you need, then load it into your shell before starting Venato:
#   set -a; source .env; set +a; .venv/bin/streamlit run app.py

# Claude assistant: an Anthropic API key. Easier: paste it in Settings → Assistant,
# which keeps it in the macOS Keychain / Windows Credential Manager instead.
ANTHROPIC_API_KEY=

# Use a different data folder (the default is ~/Library/Application Support/Venato on a Mac,
# %APPDATA%\Venato on Windows, ~/.local/share/Venato on Linux). Handy for demo data.
VENATO_DATA_DIR=

# Use a different database file (default: life.db in the data folder).
VENATO_DB=

# Path to the claude CLI, if Venato can't find Claude Code by itself.
VENATO_CLAUDE_PATH=

# Set to 1 to turn off desktop reminders (the tests do this).
VENATO_NO_REMINDERS=
